{
  "manifest_version": 3,
  "name": "PokéLeet Tracker",
  "version": "1.0.0",
  "description": "Lets your local PokéLeet know when LeetCode is your active tab, so study sessions only count time spent there.",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://leetcode.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
