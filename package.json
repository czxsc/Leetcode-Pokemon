    "@aws-sdk/rds-signer": "^3.1161.0",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
